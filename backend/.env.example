# Copy to backend/.env for local development. Never commit real secrets.
# Deployed environments get these from AWS Secrets Manager; startup fails if any placeholder remains.

OB_ENVIRONMENT=local
OB_LOG_LEVEL=INFO
OB_LOG_JSON=false

OB_DATABASE_URL=postgresql+asyncpg://oceanbook:oceanbook@localhost:5433/oceanbook
# OB_DATABASE_READ_URL=            # read replica (Phase 6); defaults to OB_DATABASE_URL
OB_REDIS_URL=redis://localhost:6379/0

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
OB_CURSOR_SIGNING_KEY=change-me-to-a-long-random-value-at-least-32-chars

# Ed25519 signing key. Generate with:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K; from cryptography.hazmat.primitives import serialization as s; print(K.generate().private_bytes(s.Encoding.PEM, s.PrivateFormat.PKCS8, s.NoEncryption()).decode())"
# Locally it may be left unset (an ephemeral key is generated; tokens die on restart).
# OB_JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# OB_JWT_PUBLIC_KEYS_JSON={"previous-kid": "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
OB_JWT_SIGNING_KID=dev

OB_CORS_ALLOW_ORIGINS=http://localhost:5000
OB_TRUST_CLOUDFLARE_HEADERS=false
